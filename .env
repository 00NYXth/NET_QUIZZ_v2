# MongoDB connection string
# Atlas: mongodb+srv://user:pass@cluster.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017

# JWT secret for signing tokens (use a long random string in production)
JWT_SECRET=your-secret-key-change-this-in-production

# Admin emails (comma-separated) — these users get admin role automatically
ADMIN_EMAILS=admin@example.com

# Telegram Bot settings (get from @BotFather and @userinfobot)
